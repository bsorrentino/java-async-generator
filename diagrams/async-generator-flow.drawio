        <mxCell id="ce" link="src/main/java/org/bsc/async/executor/CancellableExecutor.java" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Helvetica;fontSize=14;fillColor=#edf6ee;strokeColor=#598363;strokeWidth=1.5;overflow=hidden;" value="&lt;div style=&quot;text-align:center;font-size:13px;color:#596579&quot;&gt;«class»&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:17px&quot;&gt;&lt;b&gt;CancellableExecutor&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;− static CURRENT_RUN: ThreadLocal&amp;lt;Run&amp;gt;&lt;br&gt;− delegate: Executor&lt;br&gt;− cancelled: AtomicBoolean&lt;br&gt;− lock: Object&lt;br&gt;− runs: Set&amp;lt;Run&amp;gt;&lt;br&gt;− waiters: Set&amp;lt;Waiter&amp;gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;+ static of(Executor): CancellableExecutor&lt;br&gt;− CancellableExecutor(Executor)&lt;br&gt;+ execute(Runnable): void&lt;br&gt;+ &amp;lt;T&amp;gt; callUntilCancelled(BlockingCall&amp;lt;T&amp;gt;): T&lt;br&gt;+ isCancelled(): boolean&lt;br&gt;+ cancel(boolean): boolean&lt;br&gt;− run(Runnable): void&lt;br&gt;− static clearInterruptUnlessStillRequested(): void&lt;br&gt;− static interruptRequestedOnCurrentThread(): boolean&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:12px;color:#596579&quot;&gt;callUntilCancelled throws InterruptedException. Borrowed executor is never shut down.&lt;/div&gt;" vertex="1">
          <mxGeometry height="400" width="510" x="790" y="500" as="geometry" />
        </mxCell>
        <mxCell id="cd" link="src/main/java/org/bsc/async/v5/CancellableDispatcher.java" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Helvetica;fontSize=14;fillColor=#edf6ee;strokeColor=#598363;strokeWidth=1.5;overflow=hidden;" value="&lt;div style=&quot;text-align:center;font-size:13px;color:#596579&quot;&gt;«class»&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:17px&quot;&gt;&lt;b&gt;CancellableDispatcher&amp;lt;E&amp;gt;&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;− executor: CancellableExecutor&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;+ executor(): CancellableExecutor&lt;br&gt;+ dispatchSync(Data&amp;lt;E&amp;gt;): void&lt;br&gt;+ cancel(boolean): boolean&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:12px;color:#596579&quot;&gt;dispatchSync and Generator.next use callUntilCancelled.&lt;/div&gt;" vertex="1">
