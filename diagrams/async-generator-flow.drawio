        <mxCell id="generator" value="&lt;div style=&quot;text-align:center;font-size:13px;color:#596579&quot;&gt;«class»&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:17px&quot;&gt;&lt;b&gt;AsyncGeneratorFlow.Generator&amp;lt;E&amp;gt;&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;~ static DEFAULT_EXECUTOR: Executor&lt;br&gt;− receiver: Receiver&amp;lt;E&amp;gt;&lt;br&gt;~ cancellableDispatcher: CancellableDispatcher&amp;lt;E&amp;gt;&lt;br&gt;− endData: Data&amp;lt;E&amp;gt; [0..1]&lt;br&gt;− parentRegistration: AtomicReference&amp;lt;Registration&amp;gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;+ next(): Data&amp;lt;E&amp;gt;&lt;br&gt;+ receiver(): Receiver&amp;lt;E&amp;gt;&lt;br&gt;+ cancel(boolean): boolean&lt;br&gt;+ onCancel(Listener): Registration&lt;br&gt;+ resultValue(): Optional&amp;lt;Object&amp;gt;&lt;br&gt;+ close(): void&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:12px;color:#596579&quot;&gt;Extends AsyncGenerator.BaseCancellable&amp;lt;E&amp;gt; (tab 2).&lt;/div&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Helvetica;fontSize=14;fillColor=#edf6ee;strokeColor=#598363;strokeWidth=1.5;overflow=hidden;" link="src/main/java/org/bsc/async/v5/AsyncGeneratorFlow.java">
