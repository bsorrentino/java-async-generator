        <mxCell id="builder" value="&lt;div style=&quot;text-align:center;font-size:13px;color:#596579&quot;&gt;«class»&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:17px&quot;&gt;&lt;b&gt;AsyncGeneratorFlow.Builder&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;− processor: Processor&amp;lt;?&amp;gt;&lt;br&gt;− executor: Executor&lt;br&gt;− parent: IsCancellableEx&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;+ &amp;lt;E&amp;gt; processor(Processor&amp;lt;E&amp;gt;): Builder&lt;br&gt;+ executor(Executor): Builder&lt;br&gt;+ cancelledBy(IsCancellableEx): Builder&lt;br&gt;+ &amp;lt;E&amp;gt; build(): Generator&amp;lt;E&amp;gt;&lt;br&gt;+ &amp;lt;E&amp;gt; build(Consumer&amp;lt;Dispatcher&amp;lt;E&amp;gt;&amp;gt;): Generator&amp;lt;E&amp;gt;&lt;/div&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Helvetica;fontSize=14;fillColor=#edf6ee;strokeColor=#598363;strokeWidth=1.5;overflow=hidden;" link="src/main/java/org/bsc/async/v5/AsyncGeneratorFlow.java">
