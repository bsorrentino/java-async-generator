        <mxCell id="subtitle" value="Inherited contracts and resource lifecycle. Names prefixed AsyncGenerator are nested in that interface. Data and embedded-generator payload records are expanded in tab 3." vertex="1" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=15;fontStyle=0;fontColor=#253448;spacing=0;">
