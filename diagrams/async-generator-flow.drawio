        <mxCell id="cdisp" value="&lt;div style=&quot;text-align:center;font-size:13px;color:#596579&quot;&gt;«class»&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:17px&quot;&gt;&lt;b&gt;CancellableDispatcher&amp;lt;E&amp;gt;&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;− delegate: Dispatcher&amp;lt;E&amp;gt;&lt;br&gt;− executor: CancellableExecutor&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;+ dispatchSync(Data&amp;lt;E&amp;gt;): void throws InterruptedException&lt;br&gt;+ dispatchAsync(Data&amp;lt;E&amp;gt;): void&lt;br&gt;+ executor(): CancellableExecutor&lt;br&gt;~ complete(): void&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:12px;color:#596579&quot;&gt;Package-private cancellation decorator; see tab 3.&lt;/div&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Helvetica;fontSize=14;fillColor=#edf6ee;strokeColor=#598363;strokeWidth=1.5;overflow=hidden;" link="src/main/java/org/bsc/async/v5/CancellableDispatcher.java">
