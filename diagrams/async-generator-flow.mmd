classDiagram
    direction TB

    %% Current AsyncGeneratorFlow implementation and supporting production types.
    %% Selected members; legacy queue API, reactive adapters and map/reduce helpers omitted.
    %% Qualified labels identify nested Java types. JDK types appear in signatures.
    %% Dashed hollow triangle: implements; solid hollow triangle: extends.

    class Flow["AsyncGeneratorFlow"] {
        <<interface>>
        +builder() Builder$
        +create(Consumer~Dispatcher~ emitter) Generator~E~$
        +create(Processor~E~ processor) Generator~E~$
    }
    class Builder["AsyncGeneratorFlow.Builder"] {
        -Processor processor
        -Executor executor
        -IsCancellableEx parent
        +processor(Processor processor) Builder
        +executor(Executor executor) Builder
        +cancelledBy(IsCancellableEx parent) Builder
        +build() Generator~E~
        +build(Consumer~Dispatcher~ emitter) Generator~E~
    }
    class Generator["AsyncGeneratorFlow.Generator<E>"] {
        ~Executor DEFAULT_EXECUTOR$
        -Thread executorThread
        -Data~E~ endData
        -Receiver~E~ receiver
        ~CancellableDispatcher~E~ cancellableDispatcher
        -AtomicReference~Registration~ parentRegistration
        +receiver() Receiver~E~
        +next() Data~E~
        +cancel(boolean mayInterruptIfRunning) boolean
        +onCancel(Listener listener) Registration
        +resultValue() Optional~Object~
        +close() void
        ~linkToParent(IsCancellableEx parent) void
        ~unlinkFromParent() void
        -complete(Data~E~ data) Data~E~
        -end(Data~E~ data) Data~E~
    }
    class Processor["AsyncGeneratorFlow.Processor<E>"] {
        <<interface>>
        +dispatcher() Dispatcher~E~
        +receiver() Receiver~E~
    }
    class Dispatcher["AsyncGeneratorFlow.Dispatcher<E>"] {
        <<interface>>
        +dispatchSync(Data~E~ data) void
        +dispatchAsync(Data~E~ data) void
    }
    class Receiver["AsyncGeneratorFlow.Receiver<E>"] {
        <<interface>>
        +waitSync() Data~E~
        +waitAsync() Optional~Data~
    }
    class QueueProcessor["BlockingQueueProcessor<E>"] {
        -BlockingQueue~Data~ queue
        -DispatcherImpl dispatcher
        -ReceiverImpl receiver
        +BlockingQueueProcessor()
        +BlockingQueueProcessor(BlockingQueue~Data~ queue)
        +queue() BlockingQueue~Data~
        +dispatcher() Dispatcher~E~
        +receiver() Receiver~E~
    }
    class DispatcherImpl["BlockingQueueProcessor<E>.DispatcherImpl"] {
        +dispatchSync(Data~E~ data) void
        +dispatchAsync(Data~E~ data) void
    }
    class ReceiverImpl["BlockingQueueProcessor<E>.ReceiverImpl"] {
        +waitSync() Data~E~
        +waitAsync() Optional~Data~
    }
    class CancellableDispatcher["CancellableDispatcher<E>"] {
        -Object listenersLock
        -Set~Listener~ listeners
        -CancellableExecutor executor
        -boolean completed
        -boolean cancelledWithInterrupt
        -Dispatcher~E~ delegate
        +executor() CancellableExecutor
        +dispatchSync(Data~E~ data) void
        +dispatchAsync(Data~E~ data) void
        +onCancel(Listener listener) Registration
        +cancel(boolean mayInterruptIfRunning) boolean
        +isCancelled() boolean
        ~complete() void
        ~isCompleted() boolean
    }

    class AsyncGenerator["AsyncGenerator<E>"] {
