    class Executor {
        <<interface>>
        +execute(Runnable command) void
    }
    class CancellableExecutor {
        -ThreadLocal~Run~ CURRENT_RUN$
        -Executor delegate
        -AtomicBoolean cancelled
        -Object lock
        -Set~Run~ runs
        -Set~Waiter~ waiters
        +of(Executor executor) CancellableExecutor$
        +execute(Runnable command) void
        +callUntilCancelled(BlockingCall~T~ call) T
        +isCancelled() boolean
        +cancel(boolean mayInterruptIfRunning) boolean
    }
    class BlockingCall["CancellableExecutor.BlockingCall<T>"] {
        <<interface>>
        +call() T
    }
    class Run["CancellableExecutor.Run"] {
        ~Thread thread
        ~boolean interruptedAtStart
        ~Run outer
        ~boolean interruptRequested
    }
    class Waiter["CancellableExecutor.Waiter"] {
        ~Thread thread
        ~boolean interruptedByCancel
    }

    %% Construction and processing.
    Flow ..> Builder : creates
    Flow ..> Generator : creates
    Builder --> "0..1" Processor : processor
    Builder --> "0..1" Executor : executor
    Builder --> "0..1" IsCancellableEx : parent
    Builder ..> QueueProcessor : creates default
    Builder ..> CancellableDispatcher : creates
    Builder ..> Generator : creates
    Generator --> "1" Receiver : receiver
    Generator --> "1" CancellableDispatcher : cancellableDispatcher
    Processor ..> Dispatcher : returns
    Processor ..> Receiver : returns
    QueueProcessor ..|> Processor
    QueueProcessor *-- "1" DispatcherImpl : dispatcher
    QueueProcessor *-- "1" ReceiverImpl : receiver
    DispatcherImpl ..|> Dispatcher
    ReceiverImpl ..|> Receiver
    CancellableDispatcher ..|> Dispatcher
    CancellableDispatcher ..|> IsCancellableEx
    CancellableDispatcher --> "1" Dispatcher : delegate
    Dispatcher ..> Data : dispatches
    Receiver ..> Data : receives

    %% Generator hierarchy and lifecycle.
    AsyncGenerator --|> Iterable
    Base ..|> AsyncGenerator
    Base ..|> AutoCloseable
    Base ..> CleanupAction : registers with Cleaner
    CleanupAction ..|> Runnable
    Cancellable --|> AsyncGenerator
    Cancellable --|> IsCancellable
    BaseCancellable --|> Base
    BaseCancellable ..|> Cancellable
    Generator --|> BaseCancellable
    Generator ..|> HasResultValue
    AsyncGenerator ..> Data : next

    %% Cancellation registration and terminal payload.
    IsCancellableEx --|> IsCancellable
    Dispatcher --|> IsCancellableEx
    Generator ..|> IsCancellableEx
    IsCancellableEx ..> Listener : callback parameter
    IsCancellableEx ..> Registration : returns
    Registration --|> AutoCloseable
    CancellableDispatcher --> "0..*" Listener : listeners
    CancellableDispatcher ..> Registration : creates removal callback
    Generator --> "0..1" Registration : parentRegistration
    Generator ..> IsCancellableEx : subscribes to parent cancellation
    Generator --> "0..1" Data : endData
    Data --> "0..1" Embed : embed
    Embed --> "1" AsyncGenerator : generator
    Embed --> "0..1" EmbedCompletionHandler : onCompletion
    Embed ..|> HasResultValue

    %% Executor tracking and interrupt propagation.
    CancellableDispatcher --> "1" CancellableExecutor : executor
    CancellableExecutor ..|> Executor
    CancellableExecutor ..|> IsCancellable
    CancellableExecutor --> "1" Executor : borrowed delegate
    CancellableExecutor ..> BlockingCall : invokes
    CancellableExecutor *-- "0..*" Run : runs
    CancellableExecutor *-- "0..*" Waiter : waiters
    CancellableExecutor --> "0..1" Run : CURRENT_RUN per thread
    Run --> "0..1" Run : outer

    note for QueueProcessor "DispatcherImpl and ReceiverImpl share one BlockingQueue of Data elements."
    note for Dispatcher "dispatchSync may throw InterruptedException. Default cancellation operations are unsupported."
    note for Receiver "waitSync may throw InterruptedException; waitAsync polls without blocking."
    note for Data "Done when both future and embed are null. Record accessors are implicit."
    note for CancellableDispatcher "Package-private decorator. Completion releases listeners without notifying cancellation."
    note for CancellableExecutor "Borrowed executor is never shut down. Any cancel wakes blocking waiters; cancel(true) also interrupts running tasks."
    note for BlockingCall "call may throw InterruptedException."
